// (#402) Renovate, the hosted Mend app (PRs by app/renovate), for the pins Dependabot cannot see.
// Dependabot (.github/dependabot.yml) keeps every `uses:` pin and the root Cargo.toml/Cargo.lock;
// Renovate stays off both, because two bots on one file open the same bump twice. What is left here:
//
// - web/engine/Cargo.lock: the page engine's own lock, which never joins folioman's (#392).
// - the wasm-bindgen PAIR: `wasm-bindgen = "=0.2.129"` in web/engine/Cargo.toml and the CLI pins,
//   `cargo install --locked wasm-bindgen-cli --version 0.2.129` in pages.yml and (#846)
//   `tool: wasm-bindgen@0.2.129` in ci.yml's wasm job.
//   The CLI refuses a module built by any other version, so all of them move in ONE PR, with no rule
//   here: every crate's source is the wasm-bindgen repo, so config:recommended's monorepo group
//   already joins them, and the regexes below find the CLI pins in every workflow. (#589) On that PR
//   ci.yml's wasm job builds the engine and runs the CLI. (#841) It does so on every push, and runs
//   smoke.mjs on a test pool there too, so a pair that ranks differently reds before the merge.
// - cargo-mutants@X.Y.Z in ci.yml and mutation-census.yml (x2): one depName, so one PR. (#354) Merge
//   it only after a census dispatch re-proves the gate on the new version.
//
// (#589) .github/workflows/automerge.yml merges the lock-maintenance and wasm-bindgen PRs once
// every check on the PR is green and its head is 3 days old. (#610) Dependabot's two groups merge
// once green: their cooldown is the delay. The cargo-mutants PR is never on its list. Do NOT set
// `automerge` here: two mergers would race. The self-hosted renovate.yml, a second copy of this
// bot, is gone.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  enabledManagers: ["cargo", "custom.regex"],
  includePaths: ["web/engine/**", ".github/workflows/**"],
  // (#589) Weekly, all of Monday (UTC). "at any time" opened about two lock PRs a day, each one a PR
  // CI run plus a main CI, CodeQL and Pages run. The default, "before 4am on monday", is a 4-hour
  // window the hosted app's runs can miss.
  lockFileMaintenance: { enabled: true, schedule: ["* * * * 1"] },
  // Leave an open PR alone outside its schedule, so a mid-week refresh never restarts
  // automerge.yml's 3-day clock. Only lock maintenance has a schedule here, so nothing else waits.
  updateNotScheduled: false,
  // config:recommended caps new PRs at 2 an hour, which would defer the rest of a crowded run.
  prHourlyLimit: 0,
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "tool: (?<depName>cargo-mutants)@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "cargo install --locked (?<depName>wasm-bindgen-cli) --version (?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "tool: (?<depName>wasm-bindgen)@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
      ],
      datasourceTemplate: "crate",
      // Every pin installs EXACTLY that version. The crate datasource's own `cargo` versioning reads a
      // bare 0.2.125 as the range ^0.2.125, finds 0.2.129 inside it and proposes nothing, ever.
      versioningTemplate: "semver",
    },
  ],
}
